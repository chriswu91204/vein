rules_version = '2';
// VEIN 資料庫權限
// - 所有人都能讀公開資料（商品、賣場、抽獎、出價、評價）
// - 每個人只能寫自己的資料：social/{自己}、shops/{自己}/…、data/users/{自己}/…、profiles/{自己}
// - 被封禁的帳號（site/bans）不能再寫入任何公開資料
// - 網站設定開啟「要求手機驗證」時，出價、下單、報名抽獎、開店與上架前必須先完成手機驗證
// - 管理員：擁有者 Google 帳號（isOwner）＋ site/admins 名單；只能做「管理」的事：審核、下架／恢復、刪除違規內容、清除過期影片、封禁帳號
//   管理員不能替別人出價、下單、改價格、改訂單、轉移所有權，也讀不到別人的私訊、匯款資料
service cloud.firestore {
  match /databases/{database}/documents {
    // 只接受 Google 帳號登入（Google 帳號一定有 email）；手機號碼只用來「驗證」，不能拿來登入或開新帳號
    function signedIn() { return request.auth != null && request.auth.token.get('email', '') != ''; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function hasPhone() { return signedIn() && ('phone_number' in request.auth.token); }
    // ⚠️ 擁有者帳號：要跟 public/js/site-config.js 的 OWNER_EMAILS 一致
    function isOwner() {
      return signedIn()
        && request.auth.token.get('email', '') == 'chriswu91204@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function isAdmin() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/site/admins)
        && request.auth.uid in get(/databases/$(database)/documents/site/admins).data.uids);
    }
    // 停權：until＝0 是永久，有時間的到期就自動恢復
    function banEnt() { return get(/databases/$(database)/documents/site/bans).data.get('uids', {}).get(request.auth.uid, {}); }
    function notBanned() {
      return !exists(/databases/$(database)/documents/site/bans)
        || !(request.auth.uid in get(/databases/$(database)/documents/site/bans).data.get('uids', {}))
        || (banEnt().get('until', 0) > 0 && banEnt().get('until', 0) < request.time.toMillis());
    }
    // 功能限制（管理員設定）：site/restrict.uids[會員][功能]＝到期時間（毫秒）
    function lim(k) {
      return signedIn() && exists(/databases/$(database)/documents/site/restrict)
        && get(/databases/$(database)/documents/site/restrict).data.get('uids', {}).get(request.auth.uid, {}).get(k, 0) > request.time.toMillis();
    }
    function touches(k) { return resource == null ? (k in request.resource.data) : request.resource.data.diff(resource.data).affectedKeys().hasAny([k]); }
    function phoneOK() {
      return hasPhone()
        || !exists(/databases/$(database)/documents/site/info)
        || !get(/databases/$(database)/documents/site/info).data.get('requirePhone', false);
    }
    // 賣家可以改自己的商品，但不能自己解除「被管理員下架」
    function blockedUnchanged() {
      return (request.resource == null
        || request.resource.data.get('blocked', false) == (resource == null ? false : resource.data.get('blocked', false)))
        && pinUnchanged();
    }
    // 置頂時間只能由伺服器（扣點後）寫入
    function pinUnchanged() {
      return request.resource == null
        || request.resource.data.get('pinUntil', 0) == (resource == null ? 0 : resource.data.get('pinUntil', 0));
    }
    function seller(uid) { return isMe(uid) && notBanned() && phoneOK(); }
    // 小編：賣場主人邀請的共同管理者（shops/{賣場}/staff/{小編}），依權限 plants／raffles／orders／design 分開
    function staffDoc(uid) { return /databases/$(database)/documents/shops/$(uid)/staff/$(request.auth.uid); }
    function staff(uid, perm) { return signedIn() && notBanned() && exists(staffDoc(uid)) && get(staffDoc(uid)).data.get('perms', {}).get(perm, false) == true; }
    function shopper(uid, perm) { return seller(uid) || staff(uid, perm); }
    function onlyKeys(ks) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ks); }
    // 管理員下架／恢復時只能動這幾個欄位
    function modOnly(extra) { return isAdmin() && resource != null && onlyKeys(['blocked', 'blockedReason', 'blockedAt', 'updatedAt'].concat(extra)); }
    // 轉移過所有權的植株：血統資料（品種、父母本、外部親本、編號、登錄時間）鎖定，成長紀錄只能新增不能改刪
    function ownDoc(pid) { return /databases/$(database)/documents/owners/$(pid); }
    function locked(pid) { return exists(ownDoc(pid)) && get(ownDoc(pid)).data.get('log', []).size() > 0; }
    // 植物現在的主人：轉移過就看 owners/{pid}.current，沒轉移過就是登錄的賣場
    function holder(uid, pid) { return signedIn() && notBanned() && (request.auth.uid == (exists(ownDoc(pid)) ? get(ownDoc(pid)).data.current : uid)
      || (staff(uid, 'plants') && (!exists(ownDoc(pid)) || get(ownDoc(pid)).data.current == uid))); }
    // 新主人只能改照顧與紀錄相關的欄位（品種、父母本、價格、上架都不能動）
    function custFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['photoCount', 'lastPhotoAt', 'lastStage', 'thumb', 'coverThumb', 'media', 'notes', 'tags', 'leaves', 'cross', 'vid', 'updatedAt']);
    }
    function custOf(uid, pid) { return signedIn() && get(/databases/$(database)/documents/shops/$(uid)/plants/$(pid)).data.get('cust', '') == request.auth.uid; }
    function ownerFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['photoCount', 'lastPhotoAt', 'lastStage', 'thumb', 'coverThumb', 'media', 'notes', 'tags', 'leaves', 'cross', 'hidden', 'private', 'vid', 'updatedAt', 'cust', 'custName', 'custAt']);
    }
    function lineageSame() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['code', 'kind', 'species', 'momId', 'momCode', 'dadId', 'dadCode', 'parentId', 'parentCode', 'momExt', 'dadExt', 'createdAt']);
    }

    // 網站設定、賣家審核、管理員名單、封禁名單、主頁素材／文字／自訂區塊（media、text、blocks、verified 認證賣家名單 只有擁有者能改）
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && (!(docId in ['admins', 'media', 'text', 'blocks', 'badges']) || isOwner());
    }

    // 管理員代綁手機：管理員寫申請，伺服器（Cloud Function）真的把手機號碼綁進登入資料，結果寫回這份文件
    match /phoneBind/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.by == request.auth.uid && request.resource.data.st == 'req'
        && request.resource.data.keys().hasOnly(['by', 'st', 'act', 'phone', 'at'])
        && request.resource.data.act in ['bind', 'unbind'] && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
    }
    // 公開的名字、頭像與「手機已驗證」標記
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.get('phoneVerified', false) == hasPhone();
      allow update: if isAdmin() && request.resource.data.get('phoneVerified', false) == resource.data.get('phoneVerified', false);
      allow delete: if isMe(uid) || isAdmin();
    }

    // 每位會員的公開互動：出價、提問、訂單、抽獎報名、追蹤、評價
    match /social/{uid} {
      function noTrade() {
        return request.resource.data.get('bids', {}).size() == 0
          && request.resource.data.get('orders', {}).size() == 0
          && request.resource.data.get('raffles', {}).size() == 0;
      }
      function tradeUnchanged() {
        return resource != null
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bids', 'orders', 'raffles']);
      }
      allow read: if true;
      allow create, update: if (isMe(uid) && notBanned() && (phoneOK() || noTrade() || tradeUnchanged())
          && !(lim('bid') && touches('bids')) && !(lim('order') && touches('orders')) && !(lim('qa') && touches('qa')) && !(lim('raffle') && touches('raffles')))
        || (isAdmin() && resource != null && onlyKeys(['qa', 'reviews', 'orders', 'follows']));
      allow delete: if isMe(uid) || isAdmin();
    }

    // 賣場
    match /shops/{uid} {
      allow read: if true;
      // 改名：已核准的賣場不能直接改名，要送 nameReq 給管理員審核
      function shopOK(u) { return exists(/databases/$(database)/documents/site/sellers) && get(/databases/$(database)/documents/site/sellers).data.get('approved', {}).get(u, false) == true; }
      function nameSame() { return request.resource.data.get('name', '') == resource.data.get('name', ''); }
      allow create: if seller(uid);
      allow update: if (seller(uid) && (nameSame() || !shopOK(uid) || isAdmin())) || isAdmin();
      allow delete: if seller(uid) || isAdmin();
      // 小編：有「賣場設定與裝修」權限可以改賣場資料；有「植物與商品」權限只能動群組與統計欄位
      allow update: if (staff(uid, 'design') && blockedUnchanged() && nameSame())
        || (staff(uid, 'plants') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups', 'serialNext', 'nPlants', 'stats', 'updatedAt']));
    }
    match /shops/{uid}/staff/{sid} {
      function inv() { return get(/databases/$(database)/documents/shops/$(uid)/invites/$(request.resource.data.inv)).data; }
      allow read: if isMe(uid) || (signedIn() && request.auth.uid == sid) || isAdmin();
      allow create: if seller(uid)
        || (signedIn() && notBanned() && request.auth.uid == sid && sid != uid
          && request.resource.data.keys().hasOnly(['perms', 'inv', 'name', 'at'])
          && exists(/databases/$(database)/documents/shops/$(uid)/invites/$(request.resource.data.inv))
          && inv().usedBy == null && inv().expiresAt > request.time.toMillis() && request.resource.data.perms == inv().perms);
      allow update: if seller(uid);
      allow delete: if seller(uid) || (signedIn() && request.auth.uid == sid) || isAdmin();
    }
    match /shops/{uid}/invites/{tok} {
      allow get: if signedIn();
      allow list: if isMe(uid);
      allow create: if seller(uid) && tok.size() >= 20
        && exists(/databases/$(database)/documents/site/verified) && uid in get(/databases/$(database)/documents/site/verified).data.get('uids', {});
      allow delete: if seller(uid) || isAdmin();
      allow update: if signedIn() && resource.data.usedBy == null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
    }
    match /shops/{uid}/plants/{pid} {
      allow read: if true;
      allow create: if (shopper(uid, 'plants') && blockedUnchanged() && !lim('list')) || isAdmin();
      // 植物轉給別人之後，原賣家就不能再改；改由現在的主人照顧（只能動紀錄相關欄位）
      allow update: if (shopper(uid, 'plants') && holder(uid, pid) && blockedUnchanged() && (!locked(pid) || lineageSame()))
        || (holder(uid, pid) && request.auth.uid != uid && !staff(uid, 'plants') && blockedUnchanged() && ownerFieldsOnly())
        // 只有「訂單」權限的小編：接受／取消訂單時只能改售出狀態與整盤庫存
        || (staff(uid, 'orders') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer', 'soldPrice', 'stock', 'soldN', 'updatedAt']))
        // 代管人：只能動照顧與紀錄欄位（上架、轉移要原主確認，由原主寫入）
        || (signedIn() && notBanned() && resource.data.get('cust', '') == request.auth.uid && blockedUnchanged() && custFieldsOnly())
        || isAdmin();
      allow delete: if (shopper(uid, 'plants') && !locked(pid)) || isAdmin();
    }
    match /shops/{uid}/plants/{pid}/photos/{photoId} {
      allow read: if true;
      allow create: if holder(uid, pid) || custOf(uid, pid);
      allow update: if shopper(uid, 'plants') && !locked(pid);
      allow delete: if (shopper(uid, 'plants') && !locked(pid)) || isAdmin();
    }
    match /shops/{uid}/raffles/{rid} {
      allow read: if true;
      allow write: if shopper(uid, 'raffles') && blockedUnchanged();
      allow update: if modOnly(['img']);
      allow delete: if isAdmin();
    }
    match /shops/{uid}/orders/{oid} {
      allow read: if true;
      allow write: if shopper(uid, 'orders') || isAdmin();
    }
    match /shops/{uid}/answers/{aid} {
      allow read: if true;
      allow write: if shopper(uid, 'orders');
      allow delete: if isAdmin();
    }

    // 議價：只有買賣雙方看得到；買家建立，賣家同意／婉拒，買家可撤回
    match /offers/{id} {
      function party() { return signedIn() && (resource.data.buyer == request.auth.uid || resource.data.seller == request.auth.uid); }
      function same() { return request.resource.data.buyer == resource.data.buyer && request.resource.data.seller == resource.data.seller
        && request.resource.data.amt == resource.data.amt && request.resource.data.pid == resource.data.pid; }
      allow read: if party() || staff(resource.data.seller, 'orders');
      allow create: if signedIn() && notBanned() && !lim('offer') && request.resource.data.buyer == request.auth.uid
        && request.resource.data.seller != request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.get('msg', '').size() <= 500 && request.resource.data.size() <= 12;
      allow update: if signedIn() && same() && (
        ((request.auth.uid == resource.data.seller || staff(resource.data.seller, 'orders')) && resource.data.status == 'open' && request.resource.data.status in ['accepted', 'rejected'])
        || (request.auth.uid == resource.data.buyer && resource.data.status == 'open' && request.resource.data.status == 'withdrawn'));
      allow delete: if isAdmin();
    }
    // 即時聊天：對話編號是兩個人的帳號用 ~ 連起來，只有這兩個人讀寫得到
    // 代管：set＝原主交給代管人（公開可讀，賣場頁用）；list／xfer＝代管人申請上架／轉移，原主確認
    match /cust/{id} {
      function cparty(d) { return signedIn() && (d.owner == request.auth.uid || d.cust == request.auth.uid); }
      allow read: if (resource != null && resource.data.k == 'set') || cparty(resource.data) || isAdmin();
      allow create: if notBanned() && cparty(request.resource.data) && request.resource.data.by == request.auth.uid
        && request.resource.data.k in ['set', 'list', 'xfer'] && request.resource.data.owner != request.resource.data.cust
        && (request.resource.data.k == 'set' ? request.resource.data.owner == request.auth.uid : (request.resource.data.cust == request.auth.uid && request.resource.data.status == 'pending'));
      allow update: if (resource.data.k == 'set' && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid && request.resource.data.k == 'set')
        || (cparty(resource.data) && request.resource.data.owner == resource.data.owner && request.resource.data.cust == resource.data.cust && request.resource.data.k == resource.data.k
          && (resource.data.k == 'set' || resource.data.owner == request.auth.uid));
      allow delete: if cparty(resource.data) || isAdmin();
    }
    match /chats/{cid} {
      function mem() { return signedIn() && request.auth.uid in cid.split('~'); }
      function isG() { return cid.matches('g_[A-Za-z0-9]{6,40}'); }
      // 群組：成員看 chats/{cid}.members
      function gmem() { return signedIn() && isG() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members; }
      allow get: if mem() || isAdmin() || (signedIn() && isG() && (request.auth.uid in resource.data.members || resource.data.get('invites', {}).get(request.auth.uid, false) == true));
      allow list: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();
      allow create: if (mem() && notBanned() && cid.split('~').size() == 2
        && request.resource.data.members.hasAll(cid.split('~')) && request.resource.data.members.size() == 2)
        || (isG() && signedIn() && notBanned() && request.resource.data.g == true && request.resource.data.owner == request.auth.uid
          && request.auth.uid in request.resource.data.members && request.resource.data.members.size() <= 100);
      allow update: if (mem() && request.resource.data.members == resource.data.members)
        // 群組成員：可改名、邀請、加人；自己退出；群主可移除成員
        || (isG() && signedIn() && request.auth.uid in resource.data.members && request.resource.data.g == true && request.resource.data.owner == resource.data.owner
          && (request.resource.data.members.hasAll(resource.data.members)
            || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            || request.auth.uid == resource.data.owner))
        // 被邀請的人：把自己加進來
        || (isG() && signedIn() && notBanned() && !(request.auth.uid in resource.data.members) && resource.data.get('invites', {}).get(request.auth.uid, false) == true
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invites', 'updatedAt', 'read']));
      match /messages/{mid} {
        allow read: if mem() || gmem() || isAdmin();
        allow create: if (mem() || gmem()) && notBanned() && !lim('chat') && request.resource.data.from == request.auth.uid
          && request.resource.data.size() <= 20
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
        allow update: if ((mem() || gmem()) && resource.data.from != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resp', 'respAt', 'respBy']))
          // 自己的訊息：修改、收回
          || ((mem() || gmem()) && resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edAt', 'del'])
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000)));
      }
    }
    // 市集：管理員建立；賣家報名（文件 id＝植物 id），伺服器檢查名額與條件後改成 ok／pending／no
    match /mkts/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /e/{pid} {
        allow read: if true;
        allow create: if notBanned() && request.resource.data.shop is string && shopper(request.resource.data.shop, 'plants') && request.resource.data.pid == pid && request.resource.data.status == 'new'
          && request.resource.data.deal is number && request.resource.data.deal > 0;
        allow update: if isAdmin();
        allow delete: if isAdmin() || shopper(resource.data.shop, 'plants');
      }
    }
    // VEIN 拍賣會：活動與拍品；出價（liveBid）與推進（liveTick）都交給伺服器判定
    match /lives/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /lots/{pid} {
        allow read: if true;
        allow create: if notBanned() && request.resource.data.shop is string && shopper(request.resource.data.shop, 'plants') && request.resource.data.pid == pid && request.resource.data.status == 'new'
          && request.resource.data.start is number && request.resource.data.start > 0;
        allow update: if (isAdmin() && !(resource.data.status in ['live', 'sold']))
          || (shopper(resource.data.shop, 'plants') && !(resource.data.status in ['live', 'sold', 'pass']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vid']));
        allow delete: if (isAdmin() || shopper(resource.data.shop, 'plants')) && !(resource.data.status in ['live', 'sold', 'pass']);
        match /bids/{bid} { allow read: if true; }
      }
      // 現在人數：每個在看的人一份報到紀錄（只存時間）
      match /viewers/{vid} {
        allow read: if true;
        allow create, update: if vid.size() <= 40 && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is number;
        allow delete: if true;
      }
    }
    match /liveBid/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'eid', 'lid', 'amt', 'at'])
        && request.resource.data.amt is number;
    }
    match /liveWatch/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid && id == request.resource.data.eid + '_' + request.resource.data.pid + '_' + request.auth.uid;
    }
    match /liveTick/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['eid', 'at']);
    }
    // 好友：id＝兩人 uid 排序後用 ~ 連起來；發出邀請的人建立，對方按接受
    match /friends/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.u;
      allow create: if signedIn() && notBanned() && request.resource.data.from == request.auth.uid && request.auth.uid in request.resource.data.u
        && request.resource.data.u.size() == 2 && request.resource.data.u[0] < request.resource.data.u[1]
        && fid == request.resource.data.u[0] + '~' + request.resource.data.u[1] && request.resource.data.status == 'pending';
      allow update: if signedIn() && request.auth.uid in resource.data.u && request.auth.uid != resource.data.from
        && request.resource.data.status == 'ok' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'okAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.u;
    }
    // 自訂會員 ID：handles/{小寫ID} → uid（不能重複）
    match /handles/{hid} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid && hid.matches('[a-z0-9_.]{4,20}');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // 交易私密資料（匯款帳號、匯款後五碼、物流、收貨）：只有該筆訂單的買賣雙方看得到
    // 競標觀戰：在線人數（心跳）與歡呼，不用登入也能看；內容只允許固定欄位
    match /watch/{pid}/v/{vid} {
      allow read: if true;
      allow create, update: if vid.size() <= 40 && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int;
      allow delete: if true;
    }
    match /watch/{pid}/c/{cid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['e', 'at', 'v', 't', 'n']) && request.resource.data.e is string && request.resource.data.e.size() <= 4
        && request.resource.data.at is int && request.resource.data.v is string && request.resource.data.v.size() <= 40
        && (!('n' in request.resource.data) || (request.resource.data.n is string && request.resource.data.n.size() <= 16));
    }
    // 精選點數：本人與管理員看得到；只有管理員（與伺服器）能改
    match /pts/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }
    // 遭遇戰：每個人自己的攻擊次數（只能往上加，每次最多 +60，上限 300000）
    function vSeller(u) { return exists(/databases/$(database)/documents/site/verified) && u in get(/databases/$(database)/documents/site/verified).data.get('uids', {}); }
    function encOK() { return !exists(/databases/$(database)/documents/encBan/$(request.auth.uid))
      || (get(/databases/$(database)/documents/encBan/$(request.auth.uid)).data.get('perm', false) == false
        && get(/databases/$(database)/documents/encBan/$(request.auth.uid)).data.get('until', 0) < request.time.toMillis()); }
    // 立牌：管理員產生代碼；還沒綁的賣家可以綁到自己；綁的人或管理員可以改綁、解除
    // 我的溫室：每個會員自己的展示頁裝修設定
    match /gh/{uid} {
      allow read: if true;
      allow create, update: if (isMe(uid) && notBanned() && request.resource.data.size() <= 80) || isAdmin();
      allow delete: if isMe(uid) || isAdmin();
    }
    // 植友社群：文章、按讚、留言、投票（按讚數、留言數、投票結果由伺服器計算）
    match /posts/{id} {
      function pdoc() { return get(/databases/$(database)/documents/posts/$(id)).data; }
      allow read: if true;
      allow create: if signedIn() && notBanned() && !lim('post') && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('feat', false) == false && request.resource.data.get('pin', false) == false && request.resource.data.get('hidden', false) == false
        && request.resource.data.get('likes', 0) == 0 && request.resource.data.get('cmts', 0) == 0 && !('poll' in request.resource.data);
      allow update: if (isMe(resource.data.uid) && notBanned() && !lim('post') && request.resource.data.uid == resource.data.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feat', 'pin', 'pinAt', 'likes', 'cmts', 'poll', 'hidden', 'at']))
        || isAdmin();
      allow delete: if isMe(resource.data.uid) || isAdmin();
      match /likes/{uid} {
        allow read: if true;
        allow create: if isMe(uid) && notBanned();
        allow delete: if isMe(uid);
      }
      match /cmts/{cid} {
        allow read: if true;
        allow create: if signedIn() && notBanned() && !lim('chat') && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if (signedIn() && (resource.data.uid == request.auth.uid || pdoc().uid == request.auth.uid)) || isAdmin();
      }
      // 投票：每人每題一票（文件代號＝會員~題目）
      match /votes/{vid} {
        allow read: if signedIn() && vid.split('~')[0] == request.auth.uid;
        allow create: if signedIn() && notBanned() && vid.split('~')[0] == request.auth.uid
          && request.resource.data.keys().hasOnly(['b', 'o', 'at']) && request.resource.data.o is int && vid == request.auth.uid + '~' + request.resource.data.b;
      }
    }
    match /pstat/{uid} { allow read: if true; }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
    }
    // 管理員給會員的警告：本人看得到、可以按「我知道了」
    match /warns/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
      allow update: if isMe(uid) && onlyKeys(['ack']);
    }
    // 會員上線紀錄（最近幾次的時間與裝置），只有本人與管理員看得到
    // 瀏覽紀錄：本人只能新增（文件 id 一定是自己的 uid_時間），只有管理員能讀、刪；伺服器每天刪掉 7 天前的
    match /views/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && id.matches(request.auth.uid + '_[0-9]+') && request.resource.data.L is list && request.resource.data.L.size() <= 200;
      allow read, delete: if isAdmin();
    }
    match /seen/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isMe(uid) && request.resource.data.get('log', []).size() <= 30;
    }
    // 管理員操作紀錄：誰、對誰、做了什麼（只能新增，不能改）
    match /admlog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
    }
    // 溫室訪客留言板：登入就能留言；本人、留言者、管理員可以刪
    match /ghMsg/{uid}/m/{mid} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && !lim('chat') && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 200;
      allow delete: if isMe(uid) || (signedIn() && resource.data.from == request.auth.uid) || isAdmin();
    }
    match /tags/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['target', 'boundBy', 'boundAt'])
        && ((resource.data.get('boundBy', null) == null && (resource.data.get('assignedTo', null) == null || resource.data.assignedTo == request.auth.uid)) || resource.data.boundBy == request.auth.uid)
        && (request.resource.data.boundBy == request.auth.uid || (request.resource.data.boundBy == null && request.resource.data.target == null))
        && (request.resource.data.target == null || request.resource.data.target.shop == request.auth.uid));
    }
    match /ordAct/{uid} {
      allow read: if isMe(uid);
    }
    match /encBan/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin(); // 管理員可以解除鎖定或清除取消次數
    }
    match /encHits/{id} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && encOK() && request.resource.data.uid == request.auth.uid && id == request.resource.data.pid + '~' + request.auth.uid
        && request.resource.data.keys().hasOnly(['pid', 'uid', 'n', 'r', 'at']) && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 60;
      allow update: if signedIn() && encOK() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.pid == resource.data.pid
        && request.resource.data.keys().hasOnly(['pid', 'uid', 'n', 'r', 'at']) && request.resource.data.n is int && request.resource.data.n >= 0
        && (request.resource.data.get('r', 0) == resource.data.get('r', 0)
              ? (request.resource.data.n >= resource.data.n && request.resource.data.n <= resource.data.n + 60)
              : (request.resource.data.get('r', 0) > resource.data.get('r', 0) && request.resource.data.n <= 60))
        && request.resource.data.n <= 300000;
    }
    // 遭遇戰即時聊天：登入就能說話（60 字內），只能新增；遊戲結束 1 分鐘後伺服器整批清掉
    match /encChat/{rid}/m/{mid} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 30 && request.resource.data.at is int;
      allow delete: if isAdmin();
    }
    // 遭遇戰攻擊加總：每場 8 格，每人固定寫一格，只能往上加（每次最多 400 下、參加人數一次最多 +1）
    match /encAgg/{rid}/s/{k} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && encOK() && k in ['0', '1', '2', '3', '4', '5', '6', '7']
        && request.resource.data.keys().hasOnly(['n', 'u', 'at']) && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 400
        && request.resource.data.get('u', 0) is int && request.resource.data.get('u', 0) >= 0 && request.resource.data.get('u', 0) <= 1;
      allow update: if signedIn() && notBanned() && encOK() && request.resource.data.keys().hasOnly(['n', 'u', 'at']) && request.resource.data.n is int
        && request.resource.data.n >= resource.data.n && request.resource.data.n <= resource.data.n + 400
        && request.resource.data.get('u', 0) >= resource.data.get('u', 0) && request.resource.data.get('u', 0) <= resource.data.get('u', 0) + 1;
    }
    // 遭遇戰：收服（伺服器擲骰後把結果寫回）
    match /encTry/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && notBanned() && !lim('enc') && encOK() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pid', 'shop', 'price', 'ok', 'at']);
    }
    // 福利組合：認證賣家建立；搶購：每一組只能被建立一次（先搶先贏），時間到才能搶
    match /drops/{id} {
      allow read: if true;
      allow create, update: if seller(request.resource.data.shop) && vSeller(request.resource.data.shop) && (resource == null || resource.data.shop == request.resource.data.shop);
      allow delete: if (signedIn() && resource.data.shop == request.auth.uid) || isAdmin();
    }
    match /dropClaims/{id} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'did', 'bid', 'shop', 'at'])
        && id == request.resource.data.did + '~' + request.resource.data.bid
        && exists(/databases/$(database)/documents/drops/$(request.resource.data.did))
        && get(/databases/$(database)/documents/drops/$(request.resource.data.did)).data.shop == request.resource.data.shop
        && request.resource.data.shop != request.auth.uid
        && get(/databases/$(database)/documents/drops/$(request.resource.data.did)).data.at <= request.time.toMillis();
      allow delete: if isAdmin() || (signedIn() && resource.data.shop == request.auth.uid);
    }
    // 管理員推播：建立後伺服器送給全站
    match /broadcast/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'body', 'link', 'target', 'by', 'at', 'uids'])
        && (!('uids' in request.resource.data) || (request.resource.data.uids is list && request.resource.data.uids.size() <= 300))
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.body is string && request.resource.data.body.size() <= 120;
    }
    // 置頂／商店精選申請：賣家建立，伺服器驗證點數與名額後處理
    match /boostReq/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pid', 'kind', 'b', 'at']) && request.resource.data.kind in ['pin', 'feat', 'sync'];
    }
    match /feat/{b} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 訂單留言（買賣雙方、有訂單權限的小編）
    match /ordmsg/{shop}/o/{oid}/m/{mid} {
      function ordDoc() { return /databases/$(database)/documents/shops/$(shop)/orders/$(oid); }
      function socDoc() { return /databases/$(database)/documents/social/$(request.auth.uid); }
      function ordParty() {
        return signedIn() && (request.auth.uid == shop || staff(shop, 'orders')
          || (exists(socDoc()) && get(socDoc()).data.get('orders', {}).get(oid, {}).get('seller', '') == shop)
          || (exists(ordDoc()) && get(ordDoc()).data.get('buyer', '') == request.auth.uid));
      }
      allow read: if ordParty() || isAdmin();
      allow create: if ordParty() && notBanned() && !lim('chat') && request.resource.data.from == request.auth.uid
        && request.resource.data.size() <= 8
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 600));
    }
    match /deals/{id} {
      allow read: if signedIn() && (resource.data.buyer == request.auth.uid || resource.data.seller == request.auth.uid || staff(resource.data.seller, 'orders') || isAdmin());
      allow create: if signedIn() && ((request.resource.data.seller == request.auth.uid && id.matches(request.auth.uid + '_.*'))
        || (staff(request.resource.data.seller, 'orders') && id.matches(request.resource.data.seller + '_.*')));
      allow update: if signedIn() && (request.auth.uid == resource.data.seller || request.auth.uid == resource.data.buyer || staff(resource.data.seller, 'orders'))
        && request.resource.data.seller == resource.data.seller && request.resource.data.buyer == resource.data.buyer;
    }

    // 所有權轉移連結：知道連結（隨機代碼）的人才讀得到；目前所有者建立、取消；對方接受後標記完成
    match /xfers/{token} {
      function curOwner(shop, p) { return exists(ownDoc(p)) ? get(ownDoc(p)).data.current : shop; }
      allow get: if true;
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if signedIn() && notBanned() && token.size() >= 20
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'open'
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shop)/plants/$(request.resource.data.pid))
        && curOwner(request.resource.data.shop, request.resource.data.pid) == request.auth.uid
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 86400000;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'to', 'doneAt'])
        && resource.data.status == 'open'
        && ((request.auth.uid == resource.data.from && request.resource.data.status == 'cancelled')
          || (request.resource.data.status == 'done' && request.resource.data.to == request.auth.uid
            && get(ownDoc(resource.data.pid)).data.current == request.auth.uid));
      allow delete: if isAdmin();
    }

    // 現場轉讓請求：買家（碰 NFC 或掃面對面 QR）送出，目前主人 5 分鐘內確認或婉拒；買家可以取消
    match /xreq/{id} {
      function ownNow(shop, p) { return exists(ownDoc(p)) ? get(ownDoc(p)).data.current : shop; }
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.owner != request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shop)/plants/$(request.resource.data.pid))
        && ownNow(request.resource.data.shop, request.resource.data.pid) == request.resource.data.owner
        && request.resource.data.exp <= request.time.toMillis() + 6 * 60000;
      allow update: if signedIn() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
        && ((request.auth.uid == resource.data.owner && request.resource.data.status in ['done', 'rejected'])
          || (request.auth.uid == resource.data.from && request.resource.data.status == 'cancelled'));
      allow delete: if isAdmin();
    }
    // 賣家代碼登記簿：一個代碼只能屬於一個賣場，先登記的人才能用
    match /codes/{code} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && code.matches('^[A-Z0-9]{2,4}$')
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.auth.uid));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // 面對面轉移的 QR 代碼（5 分鐘有效）
    match /xqr/{tok} {
      allow get: if true;
      allow create: if signedIn() && notBanned() && tok.size() >= 16
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.exp <= request.time.toMillis() + 6 * 60000;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // 所有權履歷：任何人可讀；目前所有者可以轉移；買家憑已出貨／完成的訂單、或憑轉移連結取得所有權
    match /owners/{pid} {
      function xf() { return get(/databases/$(database)/documents/xfers/$(request.resource.data.xfer)).data; }
      function xferOk(cur) {
        return ('xfer' in request.resource.data)
          && exists(/databases/$(database)/documents/xfers/$(request.resource.data.xfer))
          && xf().pid == pid && xf().shop == request.resource.data.shop && xf().status == 'open' && xf().from == cur
          && xf().expiresAt > request.time.toMillis()
          && request.resource.data.current == request.auth.uid && request.auth.uid != cur;
      }
      function ordOf(c) { return get(/databases/$(database)/documents/shops/$(c.shop)/orders/$(c.oid)).data; }
      function claimOk() {
        return ('claim' in request.resource.data)
          && ordOf(request.resource.data.claim).buyer == request.auth.uid
          && ordOf(request.resource.data.claim).items.hasAny([pid])
          && ordOf(request.resource.data.claim).status in ['shipped', 'done']
          && request.resource.data.current == request.auth.uid;
      }
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shop)/plants/$(pid))
        // 所有權只能由現在的主人本人轉出，或買家憑訂單／轉移連結領取；管理員、小編都不能直接改
        && (request.auth.uid == request.resource.data.shop
          || (claimOk() && request.resource.data.claim.shop == request.resource.data.shop)
          || xferOk(request.resource.data.shop));
      allow update: if signedIn() && notBanned() && request.resource.data.shop == resource.data.shop
        && (request.auth.uid == resource.data.current
          || (claimOk() && request.resource.data.claim.shop == resource.data.current)
          || xferOk(resource.data.current));
      allow delete: if isAdmin();
    }

    // 手機簡訊驗證次數：每人每天 3 次、每月 10 次。日期用伺服器時間（台灣時間）算，只能一次 +1，改網頁也繞不過；管理員可以刪掉重設
    match /smsq/{uid} {
      function tw() { return request.time + duration.value(8, 'h'); }
      function dk() { return tw().year() * 10000 + tw().month() * 100 + tw().day(); }
      function mk() { return tw().year() * 100 + tw().month(); }
      allow read: if isMe(uid) || isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['dk', 'mk', 'dn', 'mn'])
        && request.resource.data.dk == dk() && request.resource.data.mk == mk()
        && request.resource.data.dn == ((resource != null && resource.data.dk == dk()) ? resource.data.dn + 1 : 1)
        && request.resource.data.mn == ((resource != null && resource.data.mk == mk()) ? resource.data.mn + 1 : 1)
        && request.resource.data.dn <= 3 && request.resource.data.mn <= 10;
    }
    // 升級成認證會員的申請：本人建立（每人一份，覆寫）；管理員讀取、處理後刪除
    match /upreq/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isMe(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'shop', 'kind', 'why', 'cur', 'at']);
    }
    // 異常流量回報：每台裝置一份（覆寫，不會一直變多）；只有管理員看得到、可以清除。
    // 帳號欄位只能填自己（或未登入填 null），沒辦法栽贓別人。是否停權由管理員決定，不會自動封鎖。
    match /abuse/{dev} {
      allow read, delete: if isAdmin();
      allow create, update: if dev.size() >= 8 && dev.size() <= 40 && dev != '_budget'
        && request.resource.data.keys().hasOnly(['dev', 'uid', 'name', 'ua', 'last', 'n', 'ev'])
        && request.resource.data.dev == dev
        && request.resource.data.uid == (request.auth == null ? null : request.auth.uid)
        && request.resource.data.ev is list && request.resource.data.ev.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && (resource == null || resource.data.uid == null || resource.data.uid == request.resource.data.uid);
    }

    // 私人資料（收藏、購物車）：只有本人看得到
    // 一頁式廣告：大家都能看；只有管理員能建立、修改、刪除
    match /landings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /data/users/{uid}/{rest=**} {
      allow read, write: if isMe(uid);
    }
    // 小編：處理訂單時要看到賣場的匯款帳號；有植物權限可以排日常照顧
    match /data/users/{uid}/bank {
      allow read: if staff(uid, 'orders');
    }
    match /data/users/{uid}/care {
      allow read, write: if staff(uid, 'plants');
    }
  }
}
