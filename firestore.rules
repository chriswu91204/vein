rules_version = '2';
// VEIN 資料庫權限
// - 所有人都能讀公開資料（商品、賣場、抽獎、出價、評價）
// - 每個人只能寫自己的資料：social/{自己}、shops/{自己}/…、data/users/{自己}/…、profiles/{自己}
// - 被封禁的帳號（site/bans）不能再寫入任何公開資料
// - 網站設定開啟「要求手機驗證」時，出價、下單、報名抽獎、開店與上架前必須先完成手機驗證
// - 管理員：擁有者 Google 帳號（isOwner）＋ site/admins 名單；只能做「管理」的事：審核、下架／恢復、刪除違規內容、清除過期影片、封禁帳號
//   管理員不能替別人出價、下單、改價格、改訂單、轉移所有權，也讀不到別人的私訊、匯款資料
service cloud.firestore {
  match /databases/{database}/documents {
    // 只接受 Google 帳號登入（Google 帳號一定有 email）；手機號碼只用來「驗證」，不能拿來登入或開新帳號
    function signedIn() { return request.auth != null && request.auth.token.get('email', '') != ''; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function hasPhone() { return signedIn() && ('phone_number' in request.auth.token); }
    // ⚠️ 擁有者帳號：要跟 public/js/site-config.js 的 OWNER_EMAILS 一致
    function isOwner() {
      return signedIn()
        && request.auth.token.get('email', '') == 'chriswu91204@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function isAdmin() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/site/admins)
        && request.auth.uid in get(/databases/$(database)/documents/site/admins).data.uids);
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/site/bans)
        || !(request.auth.uid in get(/databases/$(database)/documents/site/bans).data.get('uids', {}));
    }
    function phoneOK() {
      return hasPhone()
        || !exists(/databases/$(database)/documents/site/info)
        || !get(/databases/$(database)/documents/site/info).data.get('requirePhone', false);
    }
    // 賣家可以改自己的商品，但不能自己解除「被管理員下架」
    function blockedUnchanged() {
      return request.resource == null
        || request.resource.data.get('blocked', false) == (resource == null ? false : resource.data.get('blocked', false));
    }
    function seller(uid) { return isMe(uid) && notBanned() && phoneOK(); }
    // 小編：賣場主人邀請的共同管理者（shops/{賣場}/staff/{小編}），依權限 plants／raffles／orders／design 分開
    function staffDoc(uid) { return /databases/$(database)/documents/shops/$(uid)/staff/$(request.auth.uid); }
    function staff(uid, perm) { return signedIn() && notBanned() && exists(staffDoc(uid)) && get(staffDoc(uid)).data.get('perms', {}).get(perm, false) == true; }
    function shopper(uid, perm) { return seller(uid) || staff(uid, perm); }
    function onlyKeys(ks) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ks); }
    // 管理員下架／恢復時只能動這幾個欄位
    function modOnly(extra) { return isAdmin() && resource != null && onlyKeys(['blocked', 'blockedReason', 'blockedAt', 'updatedAt'].concat(extra)); }
    // 轉移過所有權的植株：血統資料（品種、父母本、外部親本、編號、登錄時間）鎖定，成長紀錄只能新增不能改刪
    function ownDoc(pid) { return /databases/$(database)/documents/owners/$(pid); }
    function locked(pid) { return exists(ownDoc(pid)) && get(ownDoc(pid)).data.get('log', []).size() > 0; }
    // 植物現在的主人：轉移過就看 owners/{pid}.current，沒轉移過就是登錄的賣場
    function holder(uid, pid) { return signedIn() && notBanned() && (request.auth.uid == (exists(ownDoc(pid)) ? get(ownDoc(pid)).data.current : uid)
      || (staff(uid, 'plants') && (!exists(ownDoc(pid)) || get(ownDoc(pid)).data.current == uid))); }
    // 新主人只能改照顧與紀錄相關的欄位（品種、父母本、價格、上架都不能動）
    function ownerFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['photoCount', 'lastPhotoAt', 'lastStage', 'thumb', 'coverThumb', 'media', 'notes', 'tags', 'leaves', 'cross', 'hidden', 'private', 'vid', 'updatedAt']);
    }
    function lineageSame() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['code', 'kind', 'species', 'momId', 'momCode', 'dadId', 'dadCode', 'parentId', 'parentCode', 'momExt', 'dadExt', 'createdAt']);
    }

    // 網站設定、賣家審核、管理員名單、封禁名單、主頁素材／文字／自訂區塊（media、text、blocks、verified 認證賣家名單 只有擁有者能改）
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && (!(docId in ['admins', 'media', 'text', 'blocks', 'badges']) || isOwner());
    }

    // 公開的名字、頭像與「手機已驗證」標記
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.get('phoneVerified', false) == hasPhone();
      allow delete: if isMe(uid) || isAdmin();
    }

    // 每位會員的公開互動：出價、提問、訂單、抽獎報名、追蹤、評價
    match /social/{uid} {
      function noTrade() {
        return request.resource.data.get('bids', {}).size() == 0
          && request.resource.data.get('orders', {}).size() == 0
          && request.resource.data.get('raffles', {}).size() == 0;
      }
      function tradeUnchanged() {
        return resource != null
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bids', 'orders', 'raffles']);
      }
      allow read: if true;
      allow create, update: if (isMe(uid) && notBanned() && (phoneOK() || noTrade() || tradeUnchanged()))
        || (isAdmin() && resource != null && onlyKeys(['qa', 'reviews']));
      allow delete: if isMe(uid) || isAdmin();
    }

    // 賣場
    match /shops/{uid} {
      allow read: if true;
      allow create, update: if seller(uid) || modOnly(['store', 'avatar', 'banner']);
      allow delete: if seller(uid) || isAdmin();
      // 小編：有「賣場設定與裝修」權限可以改賣場資料；有「植物與商品」權限只能動群組與統計欄位
      allow update: if (staff(uid, 'design') && blockedUnchanged())
        || (staff(uid, 'plants') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups', 'serialNext', 'nPlants', 'stats', 'updatedAt']));
    }
    match /shops/{uid}/staff/{sid} {
      function inv() { return get(/databases/$(database)/documents/shops/$(uid)/invites/$(request.resource.data.inv)).data; }
      allow read: if isMe(uid) || (signedIn() && request.auth.uid == sid) || isAdmin();
      allow create: if seller(uid)
        || (signedIn() && notBanned() && request.auth.uid == sid && sid != uid
          && request.resource.data.keys().hasOnly(['perms', 'inv', 'name', 'at'])
          && exists(/databases/$(database)/documents/shops/$(uid)/invites/$(request.resource.data.inv))
          && inv().usedBy == null && inv().expiresAt > request.time.toMillis() && request.resource.data.perms == inv().perms);
      allow update: if seller(uid);
      allow delete: if seller(uid) || (signedIn() && request.auth.uid == sid) || isAdmin();
    }
    match /shops/{uid}/invites/{tok} {
      allow get: if signedIn();
      allow list: if isMe(uid);
      allow create: if seller(uid) && tok.size() >= 20
        && exists(/databases/$(database)/documents/site/verified) && uid in get(/databases/$(database)/documents/site/verified).data.get('uids', {});
      allow delete: if seller(uid) || isAdmin();
      allow update: if signedIn() && resource.data.usedBy == null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
    }
    match /shops/{uid}/plants/{pid} {
      allow read: if true;
      allow create: if shopper(uid, 'plants') && blockedUnchanged();
      // 植物轉給別人之後，原賣家就不能再改；改由現在的主人照顧（只能動紀錄相關欄位）
      allow update: if (shopper(uid, 'plants') && holder(uid, pid) && blockedUnchanged() && (!locked(pid) || lineageSame()))
        || (holder(uid, pid) && request.auth.uid != uid && !staff(uid, 'plants') && blockedUnchanged() && ownerFieldsOnly())
        // 只有「訂單」權限的小編：接受／取消訂單時只能改售出狀態與整盤庫存
        || (staff(uid, 'orders') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer', 'soldPrice', 'stock', 'soldN', 'updatedAt']))
        || modOnly(['media', 'vid']);
      allow delete: if (shopper(uid, 'plants') && !locked(pid)) || isAdmin();
    }
    match /shops/{uid}/plants/{pid}/photos/{photoId} {
      allow read: if true;
      allow create: if holder(uid, pid);
      allow update: if shopper(uid, 'plants') && !locked(pid);
      allow delete: if (shopper(uid, 'plants') && !locked(pid)) || isAdmin();
    }
    match /shops/{uid}/raffles/{rid} {
      allow read: if true;
      allow write: if shopper(uid, 'raffles') && blockedUnchanged();
      allow update: if modOnly(['img']);
      allow delete: if isAdmin();
    }
    match /shops/{uid}/orders/{oid} {
      allow read: if true;
      allow write: if shopper(uid, 'orders');
    }
    match /shops/{uid}/answers/{aid} {
      allow read: if true;
      allow write: if shopper(uid, 'orders');
      allow delete: if isAdmin();
    }

    // 議價：只有買賣雙方看得到；買家建立，賣家同意／婉拒，買家可撤回
    match /offers/{id} {
      function party() { return signedIn() && (resource.data.buyer == request.auth.uid || resource.data.seller == request.auth.uid); }
      function same() { return request.resource.data.buyer == resource.data.buyer && request.resource.data.seller == resource.data.seller
        && request.resource.data.amt == resource.data.amt && request.resource.data.pid == resource.data.pid; }
      allow read: if party() || staff(resource.data.seller, 'orders');
      allow create: if signedIn() && notBanned() && request.resource.data.buyer == request.auth.uid
        && request.resource.data.seller != request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.get('msg', '').size() <= 500 && request.resource.data.size() <= 12;
      allow update: if signedIn() && same() && (
        ((request.auth.uid == resource.data.seller || staff(resource.data.seller, 'orders')) && resource.data.status == 'open' && request.resource.data.status in ['accepted', 'rejected'])
        || (request.auth.uid == resource.data.buyer && resource.data.status == 'open' && request.resource.data.status == 'withdrawn'));
      allow delete: if isAdmin();
    }
    // 即時聊天：對話編號是兩個人的帳號用 ~ 連起來，只有這兩個人讀寫得到
    match /chats/{cid} {
      function mem() { return signedIn() && request.auth.uid in cid.split('~'); }
      allow get: if mem();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if mem() && notBanned() && cid.split('~').size() == 2
        && request.resource.data.members.hasAll(cid.split('~')) && request.resource.data.members.size() == 2;
      allow update: if mem() && request.resource.data.members == resource.data.members;
      match /messages/{mid} {
        allow read: if mem();
        allow create: if mem() && notBanned() && request.resource.data.from == request.auth.uid
          && request.resource.data.size() <= 20
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
        allow update: if mem() && resource.data.from != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resp', 'respAt', 'respBy']);
      }
    }
    // 交易私密資料（匯款帳號、匯款後五碼、物流、收貨）：只有該筆訂單的買賣雙方看得到
    // 競標觀戰：在線人數（心跳）與歡呼，不用登入也能看；內容只允許固定欄位
    match /watch/{pid}/v/{vid} {
      allow read: if true;
      allow create, update: if vid.size() <= 40 && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int;
      allow delete: if true;
    }
    match /watch/{pid}/c/{cid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['e', 'at', 'v', 't', 'n']) && request.resource.data.e is string && request.resource.data.e.size() <= 4
        && request.resource.data.at is int && request.resource.data.v is string && request.resource.data.v.size() <= 40
        && (!('n' in request.resource.data) || (request.resource.data.n is string && request.resource.data.n.size() <= 16));
    }
    // 訂單留言（買賣雙方、有訂單權限的小編）
    match /ordmsg/{shop}/o/{oid}/m/{mid} {
      function ordDoc() { return /databases/$(database)/documents/shops/$(shop)/orders/$(oid); }
      function socDoc() { return /databases/$(database)/documents/social/$(request.auth.uid); }
      function ordParty() {
        return signedIn() && (request.auth.uid == shop || staff(shop, 'orders')
          || (exists(socDoc()) && get(socDoc()).data.get('orders', {}).get(oid, {}).get('seller', '') == shop)
          || (exists(ordDoc()) && get(ordDoc()).data.get('buyer', '') == request.auth.uid));
      }
      allow read: if ordParty();
      allow create: if ordParty() && notBanned() && request.resource.data.from == request.auth.uid
        && request.resource.data.size() <= 8
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 600));
    }
    match /deals/{id} {
      allow read: if signedIn() && (resource.data.buyer == request.auth.uid || resource.data.seller == request.auth.uid || staff(resource.data.seller, 'orders'));
      allow create: if signedIn() && ((request.resource.data.seller == request.auth.uid && id.matches(request.auth.uid + '_.*'))
        || (staff(request.resource.data.seller, 'orders') && id.matches(request.resource.data.seller + '_.*')));
      allow update: if signedIn() && (request.auth.uid == resource.data.seller || request.auth.uid == resource.data.buyer || staff(resource.data.seller, 'orders'))
        && request.resource.data.seller == resource.data.seller && request.resource.data.buyer == resource.data.buyer;
    }

    // 所有權轉移連結：知道連結（隨機代碼）的人才讀得到；目前所有者建立、取消；對方接受後標記完成
    match /xfers/{token} {
      function curOwner(shop, p) { return exists(ownDoc(p)) ? get(ownDoc(p)).data.current : shop; }
      allow get: if true;
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if signedIn() && notBanned() && token.size() >= 20
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'open'
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shop)/plants/$(request.resource.data.pid))
        && curOwner(request.resource.data.shop, request.resource.data.pid) == request.auth.uid
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 86400000;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'to', 'doneAt'])
        && resource.data.status == 'open'
        && ((request.auth.uid == resource.data.from && request.resource.data.status == 'cancelled')
          || (request.resource.data.status == 'done' && request.resource.data.to == request.auth.uid
            && get(ownDoc(resource.data.pid)).data.current == request.auth.uid));
      allow delete: if isAdmin();
    }

    // 現場轉讓請求：買家（碰 NFC 或掃面對面 QR）送出，目前主人 5 分鐘內確認或婉拒；買家可以取消
    match /xreq/{id} {
      function ownNow(shop, p) { return exists(ownDoc(p)) ? get(ownDoc(p)).data.current : shop; }
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.owner != request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shop)/plants/$(request.resource.data.pid))
        && ownNow(request.resource.data.shop, request.resource.data.pid) == request.resource.data.owner
        && request.resource.data.exp <= request.time.toMillis() + 6 * 60000;
      allow update: if signedIn() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
        && ((request.auth.uid == resource.data.owner && request.resource.data.status in ['done', 'rejected'])
          || (request.auth.uid == resource.data.from && request.resource.data.status == 'cancelled'));
      allow delete: if isAdmin();
    }
    // 賣家代碼登記簿：一個代碼只能屬於一個賣場，先登記的人才能用
    match /codes/{code} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && code.matches('^[A-Z0-9]{2,4}$')
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.auth.uid));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // 面對面轉移的 QR 代碼（5 分鐘有效）
    match /xqr/{tok} {
      allow get: if true;
      allow create: if signedIn() && notBanned() && tok.size() >= 16
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.exp <= request.time.toMillis() + 6 * 60000;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // 所有權履歷：任何人可讀；目前所有者可以轉移；買家憑已出貨／完成的訂單、或憑轉移連結取得所有權
    match /owners/{pid} {
      function xf() { return get(/databases/$(database)/documents/xfers/$(request.resource.data.xfer)).data; }
      function xferOk(cur) {
        return ('xfer' in request.resource.data)
          && exists(/databases/$(database)/documents/xfers/$(request.resource.data.xfer))
          && xf().pid == pid && xf().shop == request.resource.data.shop && xf().status == 'open' && xf().from == cur
          && xf().expiresAt > request.time.toMillis()
          && request.resource.data.current == request.auth.uid && request.auth.uid != cur;
      }
      function ordOf(c) { return get(/databases/$(database)/documents/shops/$(c.shop)/orders/$(c.oid)).data; }
      function claimOk() {
        return ('claim' in request.resource.data)
          && ordOf(request.resource.data.claim).buyer == request.auth.uid
          && ordOf(request.resource.data.claim).items.hasAny([pid])
          && ordOf(request.resource.data.claim).status in ['shipped', 'done']
          && request.resource.data.current == request.auth.uid;
      }
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shop)/plants/$(pid))
        // 所有權只能由現在的主人本人轉出，或買家憑訂單／轉移連結領取；管理員、小編都不能直接改
        && (request.auth.uid == request.resource.data.shop
          || (claimOk() && request.resource.data.claim.shop == request.resource.data.shop)
          || xferOk(request.resource.data.shop));
      allow update: if signedIn() && notBanned() && request.resource.data.shop == resource.data.shop
        && (request.auth.uid == resource.data.current
          || (claimOk() && request.resource.data.claim.shop == resource.data.current)
          || xferOk(resource.data.current));
      allow delete: if isAdmin();
    }

    // 手機簡訊驗證次數：每人每天 3 次、每月 10 次。日期用伺服器時間（台灣時間）算，只能一次 +1，改網頁也繞不過；管理員可以刪掉重設
    match /smsq/{uid} {
      function tw() { return request.time + duration.value(8, 'h'); }
      function dk() { return tw().year() * 10000 + tw().month() * 100 + tw().day(); }
      function mk() { return tw().year() * 100 + tw().month(); }
      allow read: if isMe(uid) || isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['dk', 'mk', 'dn', 'mn'])
        && request.resource.data.dk == dk() && request.resource.data.mk == mk()
        && request.resource.data.dn == ((resource != null && resource.data.dk == dk()) ? resource.data.dn + 1 : 1)
        && request.resource.data.mn == ((resource != null && resource.data.mk == mk()) ? resource.data.mn + 1 : 1)
        && request.resource.data.dn <= 3 && request.resource.data.mn <= 10;
    }
    // 升級成認證會員的申請：本人建立（每人一份，覆寫）；管理員讀取、處理後刪除
    match /upreq/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isMe(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'shop', 'kind', 'why', 'cur', 'at']);
    }
    // 異常流量回報：每台裝置一份（覆寫，不會一直變多）；只有管理員看得到、可以清除。
    // 帳號欄位只能填自己（或未登入填 null），沒辦法栽贓別人。是否停權由管理員決定，不會自動封鎖。
    match /abuse/{dev} {
      allow read, delete: if isAdmin();
      allow create, update: if dev.size() >= 8 && dev.size() <= 40 && dev != '_budget'
        && request.resource.data.keys().hasOnly(['dev', 'uid', 'name', 'ua', 'last', 'n', 'ev'])
        && request.resource.data.dev == dev
        && request.resource.data.uid == (request.auth == null ? null : request.auth.uid)
        && request.resource.data.ev is list && request.resource.data.ev.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && (resource == null || resource.data.uid == null || resource.data.uid == request.resource.data.uid);
    }

    // 私人資料（收藏、購物車）：只有本人看得到
    // 一頁式廣告：大家都能看；只有管理員能建立、修改、刪除
    match /landings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /data/users/{uid}/{rest=**} {
      allow read, write: if isMe(uid);
    }
    // 小編：處理訂單時要看到賣場的匯款帳號；有植物權限可以排日常照顧
    match /data/users/{uid}/bank {
      allow read: if staff(uid, 'orders');
    }
    match /data/users/{uid}/care {
      allow read, write: if staff(uid, 'plants');
    }
  }
}
